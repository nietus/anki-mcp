{
  "name": "anki-mcp",
  "version": "0.2.0",
  "description": "MCP server for Anki: study, analyse and manage your flashcards from Claude and other MCP clients via AnkiConnect",
  "private": true,
  "type": "module",
  "bin": {
    "anki-mcp": "./build/client.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/client.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector node build/client.js",
    "pack:mcpb": "npm run build && node scripts/create-mcpb.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^16.5.0",
    "yanki-connect": "^2.1.8"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^1.1.0",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nietus/anki-mcp.git"
  },
  "keywords": [
    "anki",
    "mcp",
    "model-context-protocol",
    "flashcards",
    "spaced-repetition",
    "ankiconnect",
    "claude"
  ]
}
